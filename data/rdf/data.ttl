<https://nathantrance.github.io/SemanticWeb/id/cocktail/yoghurt-cooler> a drink:Cocktail ;
    rdfs:label "Yoghurt Cooler" ;
    dcterms:identifier "12728" ;
    dcterms:source <https://www.thecocktaildb.com/api/json/v1/1/lookup.php?i=12728> ;
    foaf:depiction <https://www.thecocktaildb.com/images/media/drink/trttrv1441254466.jpg> ;
    drink:preparation "Place all ingredients in the blender jar - cover and whiz on medium speed until well blended. Pour in one tall, 2 medium or 3 small glasses and drink up. Note: Use lots of ice in this one - great on hot days! To add ice: Remove the center of the cover while the blender is on - drop 3 or 4 ice cubs and blend until they're completely crushed." ;
    drink:servedIn <https://nathantrance.github.io/SemanticWeb/id/glass/highball-glass> ;
    drink:usesIngredient <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/yoghurt-cooler/1>,
        <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/yoghurt-cooler/2>,
        <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/yoghurt-cooler/3> ;
    schema:description "Place all ingredients in the blender jar - cover and whiz on medium speed until well blended. Pour in one tall, 2 medium or 3 small glasses and drink up. Note: Use lots of ice in this one - great on hot days! To add ice: Remove the center of the cover while the blender is on - drop 3 or 4 ice cubs and blend until they're completely crushed." ;
    schema:image <https://www.thecocktaildb.com/images/media/drink/trttrv1441254466.jpg> ;
    schema:name "Yoghurt Cooler" .

