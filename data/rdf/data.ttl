<https://nathantrance.github.io/SemanticWeb/id/cocktail/the-laverstoke> a drink:Cocktail ;
    rdfs:label "The Laverstoke" ;
    dcterms:identifier "17824" ;
    dcterms:source <https://www.thecocktaildb.com/api/json/v1/1/lookup.php?i=17824> ;
