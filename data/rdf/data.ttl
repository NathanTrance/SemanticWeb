<https://nathantrance.github.io/SemanticWeb/id/cocktail/corn-n-oil> a drink:Cocktail ;
    rdfs:label "Corn n Oil" ;
    dcterms:identifier "17830" ;
    dcterms:source <https://www.thecocktaildb.com/api/json/v1/1/lookup.php?i=17830> ;
    foaf:depiction <https://www.thecocktaildb.com/images/media/drink/pk6dwi1592767243.jpg> ;
