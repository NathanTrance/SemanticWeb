<https://nathantrance.github.io/SemanticWeb/id/cocktail/lemon-shot> a drink:Cocktail ;
    rdfs:label "Lemon Shot" ;
    dcterms:identifier "12752" ;
    dcterms:source <https://www.thecocktaildb.com/api/json/v1/1/lookup.php?i=12752> ;
    foaf:depiction <https://www.thecocktaildb.com/images/media/drink/mx31hv1487602979.jpg> ;
    drink:baseSpirit <https://nathantrance.github.io/SemanticWeb/id/spirit/rum> ;
    drink:preparation "Mix Galliano and Absolut Citron in a shot glass, lay lemon wedge sprinkled with sugar over glass and pour a rum over wedge and glass. light rum with a lighter and let burn for a second. Do shot quickly and suck on lemon. If it is done correctly, this will taste like a shot of sweet lemonade." ;
    drink:servedIn <https://nathantrance.github.io/SemanticWeb/id/glass/shot-glass> ;
    drink:usesIngredient <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/lemon-shot/1>,
        <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/lemon-shot/2>,
