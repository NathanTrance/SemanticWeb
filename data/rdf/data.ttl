<https://nathantrance.github.io/SemanticWeb/id/cocktail/coffee-vodka> a drink:Cocktail ;
    rdfs:label "Coffee-Vodka" ;
    dcterms:identifier "12800" ;
    dcterms:source <https://www.thecocktaildb.com/api/json/v1/1/lookup.php?i=12800> ;
    foaf:depiction <https://www.thecocktaildb.com/images/media/drink/qvrrvu1472667494.jpg> ;
    drink:baseSpirit <https://nathantrance.github.io/SemanticWeb/id/spirit/vodka> ;
    drink:preparation "Boil water and sugar until dissolved. Turn off heat. Slowly add dry instant coffee and continue stirring. Add a chopped vanilla bean to the vodka, then combine the cooled sugar syrup and coffee solution with the vodka. Cover tightly and shake vigorously each day for 3 weeks. Strain and filter. Its also best to let the sugar mixture cool completely so the vodka won't evaporate when its added. If you like a smoother feel to the liqueur you can add about 1 teaspoon of glycerine to the finished product." ;
    drink:servedIn <https://nathantrance.github.io/SemanticWeb/id/glass/collins-glass> ;
    drink:usesIngredient <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/coffee-vodka/1>,
        <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/coffee-vodka/2>,
        <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/coffee-vodka/3>,
        <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/coffee-vodka/4>,
        <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/coffee-vodka/5>,
        <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/coffee-vodka/6> ;
    schema:description "Boil water and sugar until dissolved. Turn off heat. Slowly add dry instant coffee and continue stirring. Add a chopped vanilla bean to the vodka, then combine the cooled sugar syrup and coffee solution with the vodka. Cover tightly and shake vigorously each day for 3 weeks. Strain and filter. Its also best to let the sugar mixture cool completely so the vodka won't evaporate when its added. If you like a smoother feel to the liqueur you can add about 1 teaspoon of glycerine to the finished product." ;
    schema:image <https://www.thecocktaildb.com/images/media/drink/qvrrvu1472667494.jpg> ;
    schema:name "Coffee-Vodka" .

<https://nathantrance.github.io/SemanticWeb/id/cocktail/coke-and-drops> a drink:Cocktail ;
