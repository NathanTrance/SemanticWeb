<https://nathantrance.github.io/SemanticWeb/id/cocktail/lassi-a-south-indian-drink> a drink:Cocktail ;
    rdfs:label "Lassi - A South Indian Drink" ;
    dcterms:identifier "12690" ;
    dcterms:source <https://www.thecocktaildb.com/api/json/v1/1/lookup.php?i=12690> ;
    foaf:depiction <https://www.thecocktaildb.com/images/media/drink/iq6scx1487603980.jpg> ;
    drink:preparation "Blend in a blender for 3 seconds. Lassi is one of the easiest things to make, and there are many ways of making it. Basically, it is buttermilk (yoghurt whisked with water), and you can choose almost any consistency that you like, from the thinnest to the thickest. Serve cold." ;
    drink:servedIn <https://nathantrance.github.io/SemanticWeb/id/glass/highball-glass> ;
    drink:usesIngredient <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/lassi-a-south-indian-drink/1>,
