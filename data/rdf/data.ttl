<https://nathantrance.github.io/SemanticWeb/id/cocktail/hot-toddy> a drink:Cocktail ;
    rdfs:label "Hot Toddy" ;
    dcterms:identifier "178345" ;
    dcterms:source <https://www.thecocktaildb.com/api/json/v1/1/lookup.php?i=178345> ;
    foaf:depiction <https://www.thecocktaildb.com/images/media/drink/ggx0lv1613942306.jpg> ;
    drink:baseSpirit <https://nathantrance.github.io/SemanticWeb/id/spirit/whisky> ;
    drink:hasTag "Winter" ;
    drink:preparation """STEP 1\r
Whisk the whisky and honey together and split between 2 heatproof glasses. Add half of the cinnamon stick to each, then top up with 200ml boiling water.\r
\r
STEP 2\r
Add a splash of lemon juice to each, then taste and add more to your preference. Finish each with a slice of lemon, studded with a clove, and serve immediately.""" ;
    drink:servedIn <https://nathantrance.github.io/SemanticWeb/id/glass/irish-coffee-cup> ;
    drink:usesIngredient <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/hot-toddy/1>,
        <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/hot-toddy/2>,
        <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/hot-toddy/3>,
        <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/hot-toddy/4>,
        <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/hot-toddy/5> ;
    schema:description """STEP 1\r
Whisk the whisky and honey together and split between 2 heatproof glasses. Add half of the cinnamon stick to each, then top up with 200ml boiling water.\r
\r
STEP 2\r
Add a splash of lemon juice to each, then taste and add more to your preference. Finish each with a slice of lemon, studded with a clove, and serve immediately.""" ;
    schema:image <https://www.thecocktaildb.com/images/media/drink/ggx0lv1613942306.jpg> ;
    schema:name "Hot Toddy" .

