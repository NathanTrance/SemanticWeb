<https://nathantrance.github.io/SemanticWeb/id/cocktail/figgy-thyme> a drink:Cocktail ;
    rdfs:label "Figgy Thyme" ;
    dcterms:identifier "178344" ;
    dcterms:source <https://www.thecocktaildb.com/api/json/v1/1/lookup.php?i=178344> ;
    foaf:depiction <https://www.thecocktaildb.com/images/media/drink/pbw4e51606766578.jpg> ;
    drink:baseSpirit <https://nathantrance.github.io/SemanticWeb/id/spirit/vodka> ;
    drink:hasTag "Christmas",
        "Sweet" ;
    drink:preparation "In a lewis bag, crush up some ice like a baller/maniac (@glacioice). Pour your precious ice into a collins glass. In a cocktail shaker, muddle the figs and thyme together. Add honey vodka, lemon juice, and a large ice cube (@glacioice). Shake until well chilled, and strain into glass. Add tonic water and finally 2 dashes of angostura bitters. Garnish with sliced figs and thyme." ;
    drink:servedIn <https://nathantrance.github.io/SemanticWeb/id/glass/highball-glass> ;
    drink:usesIngredient <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/figgy-thyme/1>,
        <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/figgy-thyme/2>,
        <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/figgy-thyme/3>,
        <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/figgy-thyme/4>,
        <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/figgy-thyme/5>,
        <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/figgy-thyme/6> ;
    schema:description "In a lewis bag, crush up some ice like a baller/maniac (@glacioice). Pour your precious ice into a collins glass. In a cocktail shaker, muddle the figs and thyme together. Add honey vodka, lemon juice, and a large ice cube (@glacioice). Shake until well chilled, and strain into glass. Add tonic water and finally 2 dashes of angostura bitters. Garnish with sliced figs and thyme." ;
    schema:image <https://www.thecocktaildb.com/images/media/drink/pbw4e51606766578.jpg> ;
    schema:name "Figgy Thyme" .

