<https://nathantrance.github.io/SemanticWeb/id/cocktail/kool-aid-slammer> a drink:Cocktail ;
    rdfs:label "Kool-Aid Slammer" ;
    dcterms:identifier "14446" ;
    dcterms:source <https://www.thecocktaildb.com/api/json/v1/1/lookup.php?i=14446> ;
    foaf:depiction <https://www.thecocktaildb.com/images/media/drink/kugu2m1504735473.jpg> ;
    drink:baseSpirit <https://nathantrance.github.io/SemanticWeb/id/spirit/vodka> ;
    drink:preparation "Fill half the shot glass with the kool-aid first. Then put a paper towel over the top of the glass and slowly pour in the vodka. If you do it right, you should be able to see that the two liquids are separated, with the vodka on top. Now slam it! The last thing you'll taste is the kool-aid." ;
    drink:servedIn <https://nathantrance.github.io/SemanticWeb/id/glass/shot-glass> ;
    drink:usesIngredient <https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/kool-aid-slammer/1>,
