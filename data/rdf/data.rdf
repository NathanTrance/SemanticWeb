        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/lassi-raita/3"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/lassi-raita/4"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/lassi-raita/5"/>
        <schema:description>Blend the yoghurt and ice cubes together, until the yoghurt becomes more liquid. Add sugar to taste. The lemon/lime is optional but it gives it a slightly tart taste. Dash of salt. Raita is also good for the summer. Instead of having a traditional salad you can make raita instead.</schema:description>
        <schema:image rdf:resource="https://www.thecocktaildb.com/images/media/drink/s4x0qj1487603933.jpg"/>
        <schema:name>Lassi Raita</schema:name>
    </NamedIndividual>
    


