        <schema:description>In a large glass, put the lime juice and sugar, and stir well. Add cold seltzer water to fill. Put the lime peels in the glass. Drink. Repeat until limes or soda run out.</schema:description>
        <schema:image rdf:resource="https://www.thecocktaildb.com/images/media/drink/5jdp5r1487603680.jpg"/>
        <schema:name>Limeade</schema:name>
