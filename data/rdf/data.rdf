        <foaf:depiction rdf:resource="https://www.thecocktaildb.com/images/media/drink/squyyq1439907312.jpg"/>
        <drink:baseSpirit rdf:resource="https://nathantrance.github.io/SemanticWeb/id/spirit/whisky"/>
        <drink:hasTag>ContemporaryClassic</drink:hasTag>
        <drink:hasTag>IBA</drink:hasTag>
        <drink:preparation>In a highball glass gently muddle the mint, sugar and water. Fill the glass with cracked ice, add Bourbon and stir well until the glass is well frosted. Garnish with a mint sprig.</drink:preparation>
        <drink:servedIn rdf:resource="https://nathantrance.github.io/SemanticWeb/id/glass/collins-glass"/>
