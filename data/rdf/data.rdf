        <foaf:depiction rdf:resource="https://www.thecocktaildb.com/images/media/drink/wwqrsw1441248662.jpg"/>
        <drink:preparation>Open the Corona. Fill the empty space in the neck in the bottle with the rum. The bottle should be filled to the top. Plug the bottle with your thumb or the palm of your hand. Turn the bottle upside-down so the rum and beer mix. Turn the bottle rightside-up, unplug, and drink.</drink:preparation>
        <drink:servedIn rdf:resource="https://nathantrance.github.io/SemanticWeb/id/glass/beer-glass"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/limona-corona/1"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/limona-corona/2"/>
        <schema:description>Open the Corona. Fill the empty space in the neck in the bottle with the rum. The bottle should be filled to the top. Plug the bottle with your thumb or the palm of your hand. Turn the bottle upside-down so the rum and beer mix. Turn the bottle rightside-up, unplug, and drink.</schema:description>
        <schema:image rdf:resource="https://www.thecocktaildb.com/images/media/drink/wwqrsw1441248662.jpg"/>
        <schema:name>Limona Corona</schema:name>
    </NamedIndividual>
    


