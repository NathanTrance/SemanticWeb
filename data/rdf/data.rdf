    <!-- https://nathantrance.github.io/SemanticWeb/id/cocktail/kiwi-martini -->

    <NamedIndividual rdf:about="https://nathantrance.github.io/SemanticWeb/id/cocktail/kiwi-martini">
        <rdf:type rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
        <dcterms:identifier>178359</dcterms:identifier>
        <dcterms:source rdf:resource="https://www.thecocktaildb.com/api/json/v1/1/lookup.php?i=178359"/>
        <rdfs:label>Kiwi Martini</rdfs:label>
        <foaf:depiction rdf:resource="https://www.thecocktaildb.com/images/media/drink/bmxmyq1630407098.jpg"/>
        <drink:baseSpirit rdf:resource="https://nathantrance.github.io/SemanticWeb/id/spirit/vodka"/>
        <drink:hasTag>Green</drink:hasTag>
        <drink:hasTag>Sharp</drink:hasTag>
        <drink:preparation>The kiwi martini is a very fun vodka cocktail and it is one of the best drinks that makes use of fresh fruit. Though there are a few recipes floating around, this is one of the easiest and it is an absolutely delightful green martini to drink.

For this recipe, you&apos;ll simply muddle slices of kiwi with simple syrup, then shake it with vodka. It&apos;s a drink that anyone can mix up in minutes and a perfect cocktail to show off your favorite vodka.</drink:preparation>
        <drink:servedIn rdf:resource="https://nathantrance.github.io/SemanticWeb/id/glass/cocktail-glass"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/kiwi-martini/1"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/kiwi-martini/2"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/kiwi-martini/3"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/kiwi-martini/4"/>
        <schema:description>The kiwi martini is a very fun vodka cocktail and it is one of the best drinks that makes use of fresh fruit. Though there are a few recipes floating around, this is one of the easiest and it is an absolutely delightful green martini to drink.

For this recipe, you&apos;ll simply muddle slices of kiwi with simple syrup, then shake it with vodka. It&apos;s a drink that anyone can mix up in minutes and a perfect cocktail to show off your favorite vodka.</schema:description>
        <schema:image rdf:resource="https://www.thecocktaildb.com/images/media/drink/bmxmyq1630407098.jpg"/>
        <schema:name>Kiwi Martini</schema:name>
    </NamedIndividual>
    


