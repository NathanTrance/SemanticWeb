        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/ipamena/4"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/ipamena/5"/>
        <schema:description>Cut half a lime into pieces, place in a shaker, add the sugar and crush. Measure the passion fruit juice, add it to the shaker and fill up with ice cubes. Close the shaker and shake vigorously. Pour the liquid into a glass, top up with ginger ale, stir with a teaspoon and then garnish the rim of the glass with a slice of lime</schema:description>
        <schema:image rdf:resource="https://www.thecocktaildb.com/images/media/drink/yswuwp1469090992.jpg"/>
        <schema:name>Ipamena</schema:name>
    </NamedIndividual>
    


