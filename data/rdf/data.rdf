        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/happy-skipper/3"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/happy-skipper/4"/>
        <schema:description>Pour Captain Morgan&apos;s Spiced Rum over ice, fill glass to top with Ginger Ale. Garnish with lime. Tastes like a cream soda. Named for the Gilligan&apos;s Island reference (&quot;The Captain&quot; *in* &quot;Ginger&quot; is a Happy Skipper!)</schema:description>
        <schema:image rdf:resource="https://www.thecocktaildb.com/images/media/drink/42w2g41487602448.jpg"/>
        <schema:name>Happy Skipper</schema:name>
    </NamedIndividual>
    


