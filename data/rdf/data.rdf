    <!-- https://nathantrance.github.io/SemanticWeb/id/cocktail/halloween-punch -->

    <NamedIndividual rdf:about="https://nathantrance.github.io/SemanticWeb/id/cocktail/halloween-punch">
        <rdf:type rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
        <dcterms:identifier>178313</dcterms:identifier>
        <dcterms:source rdf:resource="https://www.thecocktaildb.com/api/json/v1/1/lookup.php?i=178313"/>
        <rdfs:label>Halloween Punch</rdfs:label>
        <foaf:depiction rdf:resource="https://www.thecocktaildb.com/images/media/drink/7hcgyj1571687671.jpg"/>
        <drink:baseSpirit rdf:resource="https://nathantrance.github.io/SemanticWeb/id/spirit/vodka"/>
        <drink:hasTag>Halloween</drink:hasTag>
        <drink:preparation>Tip the cherry juice, orange peel, chilli, cinnamon sticks, cloves and ginger into a large saucepan. Simmer for 5 mins, then turn off the heat. Leave to cool, then chill for at least 4 hrs, or up to 2 days – the longer you leave it the more intense the flavours. If serving to young children, take the chilli out after a few hours.

When you’re ready to serve, pour the juice into a jug. Serve in glass bottles or glasses and pop a straw in each. If you&apos;re adding vodka, do so at this stage. Dangle a fangs sweet from each glass.</drink:preparation>
        <drink:servedIn rdf:resource="https://nathantrance.github.io/SemanticWeb/id/glass/punch-bowl"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/halloween-punch/1"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/halloween-punch/2"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/halloween-punch/3"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/halloween-punch/4"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/halloween-punch/5"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/halloween-punch/6"/>
        <schema:description>Tip the cherry juice, orange peel, chilli, cinnamon sticks, cloves and ginger into a large saucepan. Simmer for 5 mins, then turn off the heat. Leave to cool, then chill for at least 4 hrs, or up to 2 days – the longer you leave it the more intense the flavours. If serving to young children, take the chilli out after a few hours.

When you’re ready to serve, pour the juice into a jug. Serve in glass bottles or glasses and pop a straw in each. If you&apos;re adding vodka, do so at this stage. Dangle a fangs sweet from each glass.</schema:description>
        <schema:image rdf:resource="https://www.thecocktaildb.com/images/media/drink/7hcgyj1571687671.jpg"/>
        <schema:name>Halloween Punch</schema:name>
    </NamedIndividual>
    


