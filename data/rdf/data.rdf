  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/id/cocktail/flaming-lamborghini">
    <rdf:type rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
    <rdfs:label>Flaming Lamborghini</rdfs:label>
    <schema:name>Flaming Lamborghini</schema:name>
    <dcterms:identifier>16485</dcterms:identifier>
    <dcterms:source rdf:resource="https://www.thecocktaildb.com/api/json/v1/1/lookup.php?i=16485"/>
    <drink:preparation>Pour the Sambuca and Kahlua into the Cocktail Glass and give the drinker a straw. Pour the Baileys and Blue Curacao into two sepsrate shot glasses either side of the cocktail glass. Set light the concotion in the cocktail glass and start to drink through the straw (this drink should be drunk in one) , as the bottom of the glass is reached put out the fire by pouring the Baileys and Blue Curacao into the cocktail glass and keep drinking till it's all gone!!</drink:preparation>
