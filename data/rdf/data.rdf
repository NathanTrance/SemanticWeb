        <foaf:depiction rdf:resource="https://www.thecocktaildb.com/images/media/drink/5noda61589575158.jpg"/>
        <drink:baseSpirit rdf:resource="https://nathantrance.github.io/SemanticWeb/id/spirit/tequila"/>
        <drink:hasTag>Contemporary Classics</drink:hasTag>
        <drink:hasTag>ContemporaryClassic</drink:hasTag>
        <drink:hasTag>IBA</drink:hasTag>
        <drink:isIBA rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</drink:isIBA>
        <drink:preparation>Rub the rim of the glass with the lime slice to make the salt stick to it. Take care to moisten only the outer rim and sprinkle the salt on it. The salt should present to the lips of the imbiber and never mix into the cocktail. Shake the other ingredients with ice, then carefully pour into the glass.</drink:preparation>
        <drink:servedIn rdf:resource="https://nathantrance.github.io/SemanticWeb/id/glass/cocktail-glass"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/margarita/1"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/margarita/2"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/margarita/3"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/margarita/4"/>
        <schema:description>Rub the rim of the glass with the lime slice to make the salt stick to it. Take care to moisten only the outer rim and sprinkle the salt on it. The salt should present to the lips of the imbiber and never mix into the cocktail. Shake the other ingredients with ice, then carefully pour into the glass.</schema:description>
        <schema:image rdf:resource="https://www.thecocktaildb.com/images/media/drink/5noda61589575158.jpg"/>
        <schema:name>Margarita</schema:name>
    </NamedIndividual>
    


