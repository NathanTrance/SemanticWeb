  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/id/cocktail/french-negroni">
    <rdf:type rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
    <rdfs:label>French Negroni</rdfs:label>
    <schema:name>French Negroni</schema:name>
