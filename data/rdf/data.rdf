  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/id/cocktail/thai-iced-coffee">
    <rdf:type rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
    <rdfs:label>Thai Iced Coffee</rdfs:label>
    <schema:name>Thai Iced Coffee</schema:name>
    <dcterms:identifier>12784</dcterms:identifier>
    <dcterms:source rdf:resource="https://www.thecocktaildb.com/api/json/v1/1/lookup.php?i=12784"/>
    <drink:preparation>Prepare a pot of coffee at a good European strength. In the ground coffee, add 2 or 3 freshly ground cardamom pods. Sweeten while hot, then cool quickly. Serve in highball glass over ice, with cream. To get the layered effect, place a spoon atop the coffee and pour the milk carefully into the spoon so that it floats on the top of the coffee.</drink:preparation>
    <schema:description>Prepare a pot of coffee at a good European strength. In the ground coffee, add 2 or 3 freshly ground cardamom pods. Sweeten while hot, then cool quickly. Serve in highball glass over ice, with cream. To get the layered effect, place a spoon atop the coffee and pour the milk carefully into the spoon so that it floats on the top of the coffee.</schema:description>
    <schema:image rdf:resource="https://www.thecocktaildb.com/images/media/drink/rqpypv1441245650.jpg"/>
    <foaf:depiction rdf:resource="https://www.thecocktaildb.com/images/media/drink/rqpypv1441245650.jpg"/>
