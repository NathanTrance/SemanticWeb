    <!-- https://nathantrance.github.io/SemanticWeb/id/cocktail/bumble-bee -->

    <NamedIndividual rdf:about="https://nathantrance.github.io/SemanticWeb/id/cocktail/bumble-bee">
        <rdf:type rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
        <dcterms:identifier>14538</dcterms:identifier>
        <dcterms:source rdf:resource="https://www.thecocktaildb.com/api/json/v1/1/lookup.php?i=14538"/>
        <rdfs:label>Bumble Bee</rdfs:label>
        <foaf:depiction rdf:resource="https://www.thecocktaildb.com/images/media/drink/uwqpvv1461866378.jpg"/>
        <drink:baseSpirit rdf:resource="https://nathantrance.github.io/SemanticWeb/id/spirit/liqueur"/>
        <drink:preparation>This is a layered shot. First pour the Bailey&apos;s into the shot glass. Then take an upside down spoon and touch it to the inside wall of the glass. Carefully add the Kahlua. Repeat this process for the Sambuca. If done properly, the alcohol will stay separated and resemble a bumble bee. Enjoy!!!</drink:preparation>
        <drink:servedIn rdf:resource="https://nathantrance.github.io/SemanticWeb/id/glass/shot-glass"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/bumble-bee/1"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/bumble-bee/2"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/bumble-bee/3"/>
        <schema:description>This is a layered shot. First pour the Bailey&apos;s into the shot glass. Then take an upside down spoon and touch it to the inside wall of the glass. Carefully add the Kahlua. Repeat this process for the Sambuca. If done properly, the alcohol will stay separated and resemble a bumble bee. Enjoy!!!</schema:description>
        <schema:image rdf:resource="https://www.thecocktaildb.com/images/media/drink/uwqpvv1461866378.jpg"/>
        <schema:name>Bumble Bee</schema:name>
    </NamedIndividual>
    


