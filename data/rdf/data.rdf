        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/san-francisco/3"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/san-francisco/4"/>
        <schema:description>Take a tall glass and put in a few ice cubes, fill the vodka over it and fill with juice then the &quot;creme&quot;, to end fill in the grenadine but very carefully at the side of the glass so it will lay down in the bottom. garnish with orange and strawberry.</schema:description>
        <schema:image rdf:resource="https://www.thecocktaildb.com/images/media/drink/szmj2d1504889961.jpg"/>
        <schema:name>San Francisco</schema:name>
