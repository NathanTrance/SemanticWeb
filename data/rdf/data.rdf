  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/id/cocktail/dirty-martini">
    <rdf:type rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
    <rdfs:label>Dirty Martini</rdfs:label>
    <schema:name>Dirty Martini</schema:name>
    <dcterms:identifier>17181</dcterms:identifier>
    <dcterms:source rdf:resource="https://www.thecocktaildb.com/api/json/v1/1/lookup.php?i=17181"/>
    <drink:preparation>Pour the vodka, dry vermouth and olive brine into a cocktail shaker with a handful of ice and shake well.&#13;
Rub the rim of a martini glass with the wedge of lemon.&#13;
Strain the contents of the cocktail shaker into the glass and add the olive.&#13;
A dirty Martini contains a splash of olive brine or olive juice and is typically garnished with an olive.</drink:preparation>
    <schema:description>Pour the vodka, dry vermouth and olive brine into a cocktail shaker with a handful of ice and shake well.&#13;
Rub the rim of a martini glass with the wedge of lemon.&#13;
Strain the contents of the cocktail shaker into the glass and add the olive.&#13;
A dirty Martini contains a splash of olive brine or olive juice and is typically garnished with an olive.</schema:description>
