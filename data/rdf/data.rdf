    <!-- https://nathantrance.github.io/SemanticWeb/id/cocktail/figgy-thyme -->

    <NamedIndividual rdf:about="https://nathantrance.github.io/SemanticWeb/id/cocktail/figgy-thyme">
        <rdf:type rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
        <dcterms:identifier>178344</dcterms:identifier>
        <dcterms:source rdf:resource="https://www.thecocktaildb.com/api/json/v1/1/lookup.php?i=178344"/>
        <rdfs:label>Figgy Thyme</rdfs:label>
        <foaf:depiction rdf:resource="https://www.thecocktaildb.com/images/media/drink/pbw4e51606766578.jpg"/>
        <drink:baseSpirit rdf:resource="https://nathantrance.github.io/SemanticWeb/id/spirit/vodka"/>
        <drink:hasTag>Christmas</drink:hasTag>
        <drink:hasTag>Sweet</drink:hasTag>
        <drink:preparation>In a lewis bag, crush up some ice like a baller/maniac (@glacioice). Pour your precious ice into a collins glass. In a cocktail shaker, muddle the figs and thyme together. Add honey vodka, lemon juice, and a large ice cube (@glacioice). Shake until well chilled, and strain into glass. Add tonic water and finally 2 dashes of angostura bitters. Garnish with sliced figs and thyme.</drink:preparation>
        <drink:servedIn rdf:resource="https://nathantrance.github.io/SemanticWeb/id/glass/highball-glass"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/figgy-thyme/1"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/figgy-thyme/2"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/figgy-thyme/3"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/figgy-thyme/4"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/figgy-thyme/5"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/figgy-thyme/6"/>
        <schema:description>In a lewis bag, crush up some ice like a baller/maniac (@glacioice). Pour your precious ice into a collins glass. In a cocktail shaker, muddle the figs and thyme together. Add honey vodka, lemon juice, and a large ice cube (@glacioice). Shake until well chilled, and strain into glass. Add tonic water and finally 2 dashes of angostura bitters. Garnish with sliced figs and thyme.</schema:description>
        <schema:image rdf:resource="https://www.thecocktaildb.com/images/media/drink/pbw4e51606766578.jpg"/>
        <schema:name>Figgy Thyme</schema:name>
    </NamedIndividual>
    


