        <foaf:depiction rdf:resource="https://www.thecocktaildb.com/images/media/drink/trttrv1441254466.jpg"/>
        <drink:preparation>Place all ingredients in the blender jar - cover and whiz on medium speed until well blended. Pour in one tall, 2 medium or 3 small glasses and drink up. Note: Use lots of ice in this one - great on hot days! To add ice: Remove the center of the cover while the blender is on - drop 3 or 4 ice cubs and blend until they&apos;re completely crushed.</drink:preparation>
        <drink:servedIn rdf:resource="https://nathantrance.github.io/SemanticWeb/id/glass/highball-glass"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/yoghurt-cooler/1"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/yoghurt-cooler/2"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/yoghurt-cooler/3"/>
        <schema:description>Place all ingredients in the blender jar - cover and whiz on medium speed until well blended. Pour in one tall, 2 medium or 3 small glasses and drink up. Note: Use lots of ice in this one - great on hot days! To add ice: Remove the center of the cover while the blender is on - drop 3 or 4 ice cubs and blend until they&apos;re completely crushed.</schema:description>
        <schema:image rdf:resource="https://www.thecocktaildb.com/images/media/drink/trttrv1441254466.jpg"/>
        <schema:name>Yoghurt Cooler</schema:name>
    </NamedIndividual>
    


