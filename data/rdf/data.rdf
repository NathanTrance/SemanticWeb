  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/id/cocktail/rosemary-blue">
    <rdf:type rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
    <rdfs:label>Rosemary Blue</rdfs:label>
    <schema:name>Rosemary Blue</schema:name>
