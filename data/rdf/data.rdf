        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/dirty-martini/5"/>
        <schema:description>Pour the vodka, dry vermouth and olive brine into a cocktail shaker with a handful of ice and shake well.
Rub the rim of a martini glass with the wedge of lemon.
Strain the contents of the cocktail shaker into the glass and add the olive.
A dirty Martini contains a splash of olive brine or olive juice and is typically garnished with an olive.</schema:description>
        <schema:image rdf:resource="https://www.thecocktaildb.com/images/media/drink/vcyvpq1485083300.jpg"/>
        <schema:name>Dirty Martini</schema:name>
    </NamedIndividual>
    


