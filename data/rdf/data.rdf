        <foaf:depiction rdf:resource="https://www.thecocktaildb.com/images/media/drink/iq6scx1487603980.jpg"/>
        <drink:preparation>Blend in a blender for 3 seconds. Lassi is one of the easiest things to make, and there are many ways of making it. Basically, it is buttermilk (yoghurt whisked with water), and you can choose almost any consistency that you like, from the thinnest to the thickest. Serve cold.</drink:preparation>
        <drink:servedIn rdf:resource="https://nathantrance.github.io/SemanticWeb/id/glass/highball-glass"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/lassi-a-south-indian-drink/1"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/lassi-a-south-indian-drink/2"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/lassi-a-south-indian-drink/3"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/lassi-a-south-indian-drink/4"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/lassi-a-south-indian-drink/5"/>
        <schema:description>Blend in a blender for 3 seconds. Lassi is one of the easiest things to make, and there are many ways of making it. Basically, it is buttermilk (yoghurt whisked with water), and you can choose almost any consistency that you like, from the thinnest to the thickest. Serve cold.</schema:description>
        <schema:image rdf:resource="https://www.thecocktaildb.com/images/media/drink/iq6scx1487603980.jpg"/>
        <schema:name>Lassi - A South Indian Drink</schema:name>
    </NamedIndividual>
    


    <!-- https://nathantrance.github.io/SemanticWeb/id/cocktail/lassi-khara -->

    <NamedIndividual rdf:about="https://nathantrance.github.io/SemanticWeb/id/cocktail/lassi-khara">
        <rdf:type rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
        <dcterms:identifier>12692</dcterms:identifier>
        <dcterms:source rdf:resource="https://www.thecocktaildb.com/api/json/v1/1/lookup.php?i=12692"/>
        <rdfs:label>Lassi Khara</rdfs:label>
