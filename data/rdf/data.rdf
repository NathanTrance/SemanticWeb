  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/id/cocktail/kool-aid-slammer">
    <rdf:type rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
    <rdfs:label>Kool-Aid Slammer</rdfs:label>
    <schema:name>Kool-Aid Slammer</schema:name>
    <dcterms:identifier>14446</dcterms:identifier>
    <dcterms:source rdf:resource="https://www.thecocktaildb.com/api/json/v1/1/lookup.php?i=14446"/>
    <drink:preparation>Fill half the shot glass with the kool-aid first. Then put a paper towel over the top of the glass and slowly pour in the vodka. If you do it right, you should be able to see that the two liquids are separated, with the vodka on top. Now slam it! The last thing you'll taste is the kool-aid.</drink:preparation>
    <schema:description>Fill half the shot glass with the kool-aid first. Then put a paper towel over the top of the glass and slowly pour in the vodka. If you do it right, you should be able to see that the two liquids are separated, with the vodka on top. Now slam it! The last thing you'll taste is the kool-aid.</schema:description>
