    <!-- https://nathantrance.github.io/SemanticWeb/id/cocktail/coffee-vodka -->

    <NamedIndividual rdf:about="https://nathantrance.github.io/SemanticWeb/id/cocktail/coffee-vodka">
        <rdf:type rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
        <dcterms:identifier>12800</dcterms:identifier>
        <dcterms:source rdf:resource="https://www.thecocktaildb.com/api/json/v1/1/lookup.php?i=12800"/>
        <rdfs:label>Coffee-Vodka</rdfs:label>
        <foaf:depiction rdf:resource="https://www.thecocktaildb.com/images/media/drink/qvrrvu1472667494.jpg"/>
        <drink:baseSpirit rdf:resource="https://nathantrance.github.io/SemanticWeb/id/spirit/vodka"/>
        <drink:preparation>Boil water and sugar until dissolved. Turn off heat. Slowly add dry instant coffee and continue stirring. Add a chopped vanilla bean to the vodka, then combine the cooled sugar syrup and coffee solution with the vodka. Cover tightly and shake vigorously each day for 3 weeks. Strain and filter. Its also best to let the sugar mixture cool completely so the vodka won&apos;t evaporate when its added. If you like a smoother feel to the liqueur you can add about 1 teaspoon of glycerine to the finished product.</drink:preparation>
        <drink:servedIn rdf:resource="https://nathantrance.github.io/SemanticWeb/id/glass/collins-glass"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/coffee-vodka/1"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/coffee-vodka/2"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/coffee-vodka/3"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/coffee-vodka/4"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/coffee-vodka/5"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/coffee-vodka/6"/>
        <schema:description>Boil water and sugar until dissolved. Turn off heat. Slowly add dry instant coffee and continue stirring. Add a chopped vanilla bean to the vodka, then combine the cooled sugar syrup and coffee solution with the vodka. Cover tightly and shake vigorously each day for 3 weeks. Strain and filter. Its also best to let the sugar mixture cool completely so the vodka won&apos;t evaporate when its added. If you like a smoother feel to the liqueur you can add about 1 teaspoon of glycerine to the finished product.</schema:description>
        <schema:image rdf:resource="https://www.thecocktaildb.com/images/media/drink/qvrrvu1472667494.jpg"/>
        <schema:name>Coffee-Vodka</schema:name>
    </NamedIndividual>
    


