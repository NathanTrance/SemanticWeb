  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/id/cocktail/vodka-tonic">
    <rdf:type rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
    <rdfs:label>Vodka Tonic</rdfs:label>
    <schema:name>Vodka Tonic</schema:name>
    <dcterms:identifier>178364</dcterms:identifier>
    <dcterms:source rdf:resource="https://www.thecocktaildb.com/api/json/v1/1/lookup.php?i=178364"/>
    <drink:preparation>Wash and cut 1 wedge and 1 slice of lime or lemon.&#13;
Fill a tumbler with fresh ice.&#13;
Pour the desired dose of vodka and top up with the tonic.&#13;
Squeeze the lime wedge into the glass and decorate with the slice.&#13;
That's all, very simple: it's just the recipe for happiness!</drink:preparation>
    <schema:description>Wash and cut 1 wedge and 1 slice of lime or lemon.&#13;
