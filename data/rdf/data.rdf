  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/id/cocktail/frappe">
    <rdf:type rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
    <rdfs:label>Frappé</rdfs:label>
    <schema:name>Frappé</schema:name>
    <dcterms:identifier>12768</dcterms:identifier>
    <dcterms:source rdf:resource="https://www.thecocktaildb.com/api/json/v1/1/lookup.php?i=12768"/>
    <drink:preparation>Mix together. Blend at highest blender speed for about 1 minute. Pour into a glass and drink with a straw. Notes: This works best if everything is cold (if you make fresh coffee, mix it with the milk and let it sit in the fridge for 1/2 hour. If it is not frothy, add more milk, or even just some more milk powder. The froth gradually turns to liquid at the bottom of the glass, so you will find that you can sit and drink this for about 1/2 hour, with more iced coffee continually appearing at the bottom. Very refreshing.</drink:preparation>
    <schema:description>Mix together. Blend at highest blender speed for about 1 minute. Pour into a glass and drink with a straw. Notes: This works best if everything is cold (if you make fresh coffee, mix it with the milk and let it sit in the fridge for 1/2 hour. If it is not frothy, add more milk, or even just some more milk powder. The froth gradually turns to liquid at the bottom of the glass, so you will find that you can sit and drink this for about 1/2 hour, with more iced coffee continually appearing at the bottom. Very refreshing.</schema:description>
    <schema:image rdf:resource="https://www.thecocktaildb.com/images/media/drink/vqwryq1441245927.jpg"/>
    <foaf:depiction rdf:resource="https://www.thecocktaildb.com/images/media/drink/vqwryq1441245927.jpg"/>
