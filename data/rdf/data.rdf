  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/id/cocktail/darkwood-sling">
    <rdf:type rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
    <rdfs:label>Darkwood Sling</rdfs:label>
    <schema:name>Darkwood Sling</schema:name>
    <dcterms:identifier>14482</dcterms:identifier>
    <dcterms:source rdf:resource="https://www.thecocktaildb.com/api/json/v1/1/lookup.php?i=14482"/>
    <drink:preparation>There are many good cherry liqueurs you can use, but I prefere Heering. Add one share of the liqueur. Then you add one share of Soda. For a sour sling use Tonic (most people prefer the drink without Tonic). Afterwards you fill the glass with Orange Juice and ice cubes.</drink:preparation>
    <schema:description>There are many good cherry liqueurs you can use, but I prefere Heering. Add one share of the liqueur. Then you add one share of Soda. For a sour sling use Tonic (most people prefer the drink without Tonic). Afterwards you fill the glass with Orange Juice and ice cubes.</schema:description>
    <schema:image rdf:resource="https://www.thecocktaildb.com/images/media/drink/sxxsyq1472719303.jpg"/>
    <foaf:depiction rdf:resource="https://www.thecocktaildb.com/images/media/drink/sxxsyq1472719303.jpg"/>
    <drink:servedIn rdf:resource="https://nathantrance.github.io/SemanticWeb/id/glass/cocktail-glass"/>
    <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/darkwood-sling/1"/>
    <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/darkwood-sling/2"/>
    <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/darkwood-sling/3"/>
