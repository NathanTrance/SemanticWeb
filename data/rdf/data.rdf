  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/id/cocktail/lemouroudji">
    <rdf:type rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
    <rdfs:label>Lemouroudji</rdfs:label>
