        <drink:baseSpirit rdf:resource="https://nathantrance.github.io/SemanticWeb/id/spirit/whisky"/>
        <drink:hasTag>Winter</drink:hasTag>
        <drink:preparation>STEP 1
Whisk the whisky and honey together and split between 2 heatproof glasses. Add half of the cinnamon stick to each, then top up with 200ml boiling water.

STEP 2
Add a splash of lemon juice to each, then taste and add more to your preference. Finish each with a slice of lemon, studded with a clove, and serve immediately.</drink:preparation>
        <drink:servedIn rdf:resource="https://nathantrance.github.io/SemanticWeb/id/glass/irish-coffee-cup"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/hot-toddy/1"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/hot-toddy/2"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/hot-toddy/3"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/hot-toddy/4"/>
        <drink:usesIngredient rdf:resource="https://nathantrance.github.io/SemanticWeb/id/ingredient-amount/hot-toddy/5"/>
        <schema:description>STEP 1
Whisk the whisky and honey together and split between 2 heatproof glasses. Add half of the cinnamon stick to each, then top up with 200ml boiling water.

STEP 2
Add a splash of lemon juice to each, then taste and add more to your preference. Finish each with a slice of lemon, studded with a clove, and serve immediately.</schema:description>
        <schema:image rdf:resource="https://www.thecocktaildb.com/images/media/drink/ggx0lv1613942306.jpg"/>
        <schema:name>Hot Toddy</schema:name>
    </NamedIndividual>
    


