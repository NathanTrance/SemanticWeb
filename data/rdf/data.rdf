  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/id/cocktail/homemade-kahlua">
    <rdf:type rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
    <rdfs:label>Homemade Kahlua</rdfs:label>
    <schema:name>Homemade Kahlua</schema:name>
