<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#isIBA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">is IBA</rdfs:label>
    <rdfs:comment xml:lang="en">True when the cocktail is on the International Bartenders Association official list.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#baseSpirit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
    <rdfs:range rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Spirit"/>
    <rdfs:label xml:lang="en">base spirit</rdfs:label>
    <rdfs:comment xml:lang="en">The dominant spirit of a cocktail.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#producedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Brand"/>
    <rdfs:range rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Distillery"/>
    <rdfs:label xml:lang="en">produced by</rdfs:label>
    <rdfs:comment xml:lang="en">The distillery that manufactures a brand.</rdfs:comment>
    <owl:inverseOf rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#produces"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9392e18bdb9443e69172aa21277cc4c4b2">
    <rdf:first rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#ofIngredient"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#produces">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Distillery"/>
    <rdfs:range rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Brand"/>
    <rdfs:label xml:lang="en">produces</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse of producedBy: a distillery's range of brands.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#Cocktail">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Beverage"/>
    <rdfs:label xml:lang="en">Cocktail</rdfs:label>
    <rdfs:comment xml:lang="en">A mixed drink defined by a recipe: a base spirit plus one or more ingredient usages, served in a glass.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#hasTag">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Beverage"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">has tag</rdfs:label>
    <rdfs:comment xml:lang="en">Loose keyword from the source data (e.g. IBA, ContemporaryClassic). Kept as-is for provenance.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#amountText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#IngredientAmount"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">amount (text)</rdfs:label>
    <rdfs:comment xml:lang="en">Human-readable measure as the source gives it, e.g. "30 ml", "1 dash", "2 cl".</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#foundedYear">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Distillery"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
    <rdfs:label xml:lang="en">founded year</rdfs:label>
    <rdfs:comment xml:lang="en">Year the distillery was established, when known.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#Whisky">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Spirit"/>
    <rdfs:label xml:lang="en">Whisky</rdfs:label>
    <rdfs:comment xml:lang="en">Spirit distilled from fermented grain mash.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#preparation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">preparation</rdfs:label>
    <rdfs:comment xml:lang="en">Free-text preparation instructions.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#usesIngredient">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
    <rdfs:range rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#IngredientAmount"/>
    <rdfs:label xml:lang="en">uses ingredient</rdfs:label>
    <rdfs:comment xml:lang="en">Links a cocktail to an ingredient-amount node (the recipe edge with a measure).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#garnish">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">garnish</rdfs:label>
    <rdfs:comment xml:lang="en">Garnish suggested for serving.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#hasBrand">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Spirit"/>
    <rdfs:range rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Brand"/>
    <rdfs:label xml:lang="en">has brand</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse of brandOf: brands classified under a spirit type.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:title xml:lang="en">drinkonto - an ontology for cocktails, spirits and distilleries</dcterms:title>
    <dcterms:description xml:lang="en">A small OWL 2 ontology modelling cocktails, their ingredient usages, the spirits and brands involved, the distilleries that produce them and the places where those distilleries are located. Reuses schema.org, Dublin Core, FOAF, WGS84 geo and SKOS where possible.</dcterms:description>
    <dcterms:creator rdf:resource="https://github.com/NathanTrance"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-20</dcterms:created>
    <owl:versionInfo>0.1.0</owl:versionInfo>
    <owl:versionIRI rdf:resource="https://nathantrance.github.io/SemanticWeb/ontology/drinkonto.ttl"/>
    <rdfs:seeAlso rdf:resource="https://5stardata.info/en/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#Distillery">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://schema.org/Organization"/>
    <rdfs:label xml:lang="en">Distillery</rdfs:label>
    <rdfs:comment xml:lang="en">A physical production site that makes one or more brands.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#Spirit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Beverage"/>
    <rdfs:label xml:lang="en">Spirit</rdfs:label>
    <rdfs:comment xml:lang="en">A distilled alcoholic beverage type (gin, whisky, rum, ...). Instances are categories, not bottles.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#servedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
    <rdfs:range rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#GlassType"/>
    <rdfs:label xml:lang="en">served in</rdfs:label>
    <rdfs:comment xml:lang="en">Glass in which a cocktail is served.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#Vodka">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Spirit"/>
    <rdfs:label xml:lang="en">Vodka</rdfs:label>
    <rdfs:comment xml:lang="en">Rectified spirit, generally neutral in flavour.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#Beverage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://schema.org/Beverage"/>
    <rdfs:label xml:lang="en">Beverage</rdfs:label>
    <rdfs:comment xml:lang="en">Any drinkable preparation in the domain. Local umbrella class so that cocktails and spirits share a common superclass without asserting anything about non-alcoholic drinks.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#Ingredient">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://schema.org/Product"/>
    <rdfs:label xml:lang="en">Ingredient</rdfs:label>
    <rdfs:comment xml:lang="en">A component used in a recipe (juice, syrup, bitters, a specific spirit brand, ...).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#Absinthe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Spirit"/>
    <rdfs:label xml:lang="en">Absinthe</rdfs:label>
    <rdfs:comment xml:lang="en">Anise-flavoured spirit derived from botanicals.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#hasFlavorProfile">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Beverage"/>
    <rdfs:range rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#FlavorProfile"/>
    <rdfs:label xml:lang="en">has flavour profile</rdfs:label>
    <rdfs:comment xml:lang="en">Associates a beverage with taste/style descriptors.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#Tequila">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Spirit"/>
    <rdfs:label xml:lang="en">Tequila</rdfs:label>
    <rdfs:comment xml:lang="en">Mexican spirit distilled from blue agave.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#locatedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Distillery"/>
    <rdfs:range rdf:resource="https://schema.org/Place"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/spatial"/>
    <rdfs:subPropertyOf rdf:resource="https://schema.org/location"/>
    <rdfs:label xml:lang="en">located in</rdfs:label>
    <rdfs:comment xml:lang="en">Administrative place a distillery sits in. Sub-property of dcterms:spatial and schema:location so generic spatial queries still match.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#ofIngredient">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#IngredientAmount"/>
    <rdfs:range rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Ingredient"/>
    <rdfs:label xml:lang="en">of ingredient</rdfs:label>
    <rdfs:comment xml:lang="en">Points from an ingredient-amount node to the ingredient it is about.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#GlassType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://schema.org/Product"/>
    <rdfs:label xml:lang="en">Glass type</rdfs:label>
    <rdfs:comment xml:lang="en">A vessel a cocktail is served in, e.g. coupe, highball, old fashioned.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#aboutABV">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Spirit"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">about ABV</rdfs:label>
    <rdfs:comment xml:lang="en">Typical alcohol by volume in percent for a spirit type.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#Gin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Spirit"/>
    <rdfs:label xml:lang="en">Gin</rdfs:label>
    <rdfs:comment xml:lang="en">Juniper-flavoured spirit.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9392e18bdb9443e69172aa21277cc4c4b1">
    <rdf:first rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#usesIngredient"/>
    <rdf:rest rdf:nodeID="n9392e18bdb9443e69172aa21277cc4c4b2"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#Brand">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://schema.org/Brand"/>
    <rdfs:label xml:lang="en">Brand</rdfs:label>
    <rdfs:comment xml:lang="en">A commercial product line, e.g. Bombay Sapphire, Glenfiddich. Distinct from the abstract spirit type it belongs to.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#Liqueur">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Spirit"/>
    <rdfs:label xml:lang="en">Liqueur</rdfs:label>
    <rdfs:comment xml:lang="en">Sweetened, flavoured spirit.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#Rum">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Spirit"/>
    <rdfs:label xml:lang="en">Rum</rdfs:label>
    <rdfs:comment xml:lang="en">Spirit distilled from sugar cane products.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#hasIngredient">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Cocktail"/>
    <rdfs:range rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Ingredient"/>
    <rdfs:label xml:lang="en">has ingredient</rdfs:label>
    <rdfs:comment xml:lang="en">Direct cocktail-to-ingredient relation. It is NOT asserted in the data: it is derived from usesIngredient/ofIngredient via the OWL 2 property chain below, which is what a reasoner (or a SPARQL property path) exposes.</rdfs:comment>
    <owl:propertyChainAxiom rdf:nodeID="n9392e18bdb9443e69172aa21277cc4c4b1"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#countryOfOrigin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Distillery"/>
    <rdfs:range rdf:resource="https://schema.org/Country"/>
    <rdfs:label xml:lang="en">country of origin</rdfs:label>
    <rdfs:comment xml:lang="en">Country a distillery belongs to; overlaps schema:countryOfOrigin but scoped to our domain.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#brandOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Brand"/>
    <rdfs:range rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Spirit"/>
    <rdfs:label xml:lang="en">brand of</rdfs:label>
    <rdfs:comment xml:lang="en">The spirit type a brand instantiates (e.g. Bombay Sapphire is a brand of Gin).</rdfs:comment>
    <owl:inverseOf rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#hasBrand"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#amountUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#IngredientAmount"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">amount unit</rdfs:label>
    <rdfs:comment xml:lang="en">Unit of the normalised amount, e.g. ml, cl, oz, dash.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#amountValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#IngredientAmount"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">amount (numeric)</rdfs:label>
    <rdfs:comment xml:lang="en">Normalised numeric part of the measure, when it could be parsed. Enables comparisons/aggregation in SPARQL.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#IngredientAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ingredient amount</rdfs:label>
    <rdfs:comment xml:lang="en">Reification-lite node representing the use of one ingredient in one cocktail, carrying its measure. It is the edge between a cocktail and an ingredient, made addressable so measures can be queried.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#Brandy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://nathantrance.github.io/SemanticWeb/onto#Spirit"/>
    <rdfs:label xml:lang="en">Brandy</rdfs:label>
    <rdfs:comment xml:lang="en">Spirit distilled from wine or fruit must.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://nathantrance.github.io/SemanticWeb/onto#FlavorProfile">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Flavor profile</rdfs:label>
    <rdfs:comment xml:lang="en">A controlled-vocabulary descriptor of taste/style (dry, sweet, herbal, citrusy, ...). Modelled as a SKOS concept so it can be organised into broader/narrower relations.</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
